# Relay auth (generate: openssl rand -hex 32)
RELAY_TOKEN=replace_me_with_openssl_rand_hex_32

# Toss Open API credentials (from WTS 설정 > Open API)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Default accountSeq from GET /api/v1/accounts (optional; can also send X-Tossinvest-Account per request)
TOSS_ACCOUNT_SEQ=

# Optional overrides
# TOSS_BASE_URL=https://openapi.tossinvest.com
# TOSS_TOKEN_URL=https://openapi.tossinvest.com/oauth2/token
# RATE_LIMIT_PER_MINUTE=60
# HOST=127.0.0.1
# PORT=8000
